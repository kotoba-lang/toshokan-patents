;; seeds.edn — patent-id seeds for toshokan-patents.
;; hand-editable; daemon.cljs also appends citation-grown seeds (:grown-from).
;; Each seed's :query is a worldwide patent id as accepted by Google Patents
;; (US........B?, EP.......A?, JP........A?, WO........A?, CN........A?, ...).
;; The daemon walks the citation graph from these roots (DC.relation references),
;; the patent-domain analogue of toshokan growing seeds from creators.

{:policy
 {:max-records-per-tick 8        ; one patent page per tick — polite to the source
  :max-new-seeds-per-tick 10     ; cap citation-graph fan-out per tick
  :max-seeds 5000
  :sources ["google-patents"]
  :inter-source-sleep-ms 2000}

 :seeds
 [;; CRISPR-Cas9 — high-value, high-citation roots that will walk the
  ;; gene-editing citation graph across US/EP/JP/WO offices.
  {:id "crispr-broad"    :query "US8697359B1"   :note "CRISPR-Cas9 (Broad Institute)"}
  {:id "crispr-ucb"      :query "EP2784683B1"   :note "CRISPR-Cas9 (UC Berkeley / Vienna)"}
  ;; Verified live in the probe (Kansai Paint) — keep as a known-good anchor.
  {:id "paint-kansai"   :query "US10196540B2"  :note "Aqueous coating composition (Kansai Paint) — probe anchor"}
  ;; mRNA / lipid nanoparticle — another high-citation worldwide cluster.
  {:id "mrna-lnp"       :query "US10584378B2"  :note "mRNA-LNP (Karikó/Weissman lineage)"}]}
